      {
        "parameters": {
          "jsCode": "const names=['History movies','History episodes','Ratings movies','Ratings shows','Watchlist movies','Watchlist shows'];const sizes={};for(const n of names){const pages=$(n).all().map(i=>i.json);if(!pages.length)throw Error(n+': no pages');let expected=null,items=[];for(let i=0;i<pages.length;i++){const p=pages[i],h=p.headers||{},body=p.body,count=Number(h['x-pagination-item-count']),current=Number(h['x-pagination-page']),total=Number(h['x-pagination-page-count']);if(!Array.isArray(body)||!Number.isSafeInteger(count)||current!==i+1||!Number.isSafeInteger(total)||total>100||total<0)throw Error(n+': pagination shape page '+(i+1)+' bodyArray '+Array.isArray(body)+' count '+(Number.isSafeInteger(count)?count:'missing')+' current '+(Number.isSafeInteger(current)?current:'missing')+' total '+(Number.isSafeInteger(total)?total:'missing'));if(expected===null)expected=count;else if(count!==expected)throw Error(n+': count shifted');items.push(...body);}if(items.length!==expected)throw Error(n+': truncated feed expected '+expected+' got '+items.length);sizes[n]=items.length;}return [{json:{feeds:sizes,preview_only:true}}];"
