      {
        "id": "marquee_check",
        "name": "Validate Crunchyroll account",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "onError": "continueErrorOutput",
        "position": [
          784,
          304
        ],
        "parameters": {
          "jsCode": "const id=$input.first().json.account_id;if(typeof id!=='string'||!/^[a-zA-Z0-9-]{10,128}$/.test(id))throw Error('Account changed shape');return [{json:{account_id:id}}];"
        }
